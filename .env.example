# AI Medicine Information System - Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your environment.

# JWT Authentication Secret Key (Generate a random 32+ character key for production)
JWT_SECRET=replace-with-a-secure-random-32-byte-secret-key-in-production

# JWT Expiration in seconds (default: 604800 = 7 days)
JWT_EXPIRATION_SECONDS=604800

# SQLite Database File Path (defaults to data/patients.db)
DATABASE_PATH=data/patients.db

# Allowed CORS Origins (comma-separated, e.g. http://localhost:5173,https://your-domain.com)
# Leave empty or set to * for local development
CORS_ORIGINS=http://localhost:5173,http://localhost:8443,http://127.0.0.1:8000

# Server port (used by Docker and Render)
PORT=8000
